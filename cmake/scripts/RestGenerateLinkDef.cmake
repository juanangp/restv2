# Writes the LinkDef of a REST dictionary (rest_attach_dictionary), at build
# time so that it follows the headers: the class or namespace named as each
# header, what rootcling selects without LinkDef. cmake
# -DOUTPUT=<file>_LinkDef.h -DHEADERS=<header1>|<header2>|... -P
# RestGenerateLinkDef.cmake
string(REPLACE "|" ";" _headers "${HEADERS}")
string(
  CONCAT
    _content
    "// Generated by CMake (rest_attach_dictionary), do not edit\n#ifdef __CLING__\n"
    "#pragma link off all globals;\n#pragma link off all classes;\n#pragma link off all functions;\n"
)
foreach(_header IN LISTS _headers)
  get_filename_component(_name ${_header} NAME_WE)
  file(READ ${_header} _text)
  if(_text MATCHES "(^|\n)namespace ${_name}[ \t\r\n{]")
    string(APPEND _content "#pragma link C++ namespace ${_name};\n")
  elseif(_text MATCHES "(^|\n)(class|struct) ${_name}[ \t\r\n:{]")
    # Without +: with it rootcling also generates the dictionaries of the STL
    # containers of the members (e.g. vector<TRestRawSignal>, vectors of private
    # structs), which do not compile
    string(APPEND _content "#pragma link C++ class ${_name};\n")
  endif()
endforeach()
string(APPEND _content "#endif\n")
file(WRITE ${OUTPUT} "${_content}")
