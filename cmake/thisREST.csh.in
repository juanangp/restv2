#!/bin/csh
# Source this script to set up the REST v2 environment:
#   source @CMAKE_INSTALL_PREFIX@/thisREST.csh

setenv REST_SOURCE "@CMAKE_SOURCE_DIR@"
setenv REST_PATH   "@CMAKE_INSTALL_PREFIX@"

if ( $?ROOT_INCLUDE_PATH == 0 ) setenv ROOT_INCLUDE_PATH ''
setenv ROOT_INCLUDE_PATH "${REST_PATH}/include:${ROOT_INCLUDE_PATH}"
setenv PATH              "${REST_PATH}/bin:${PATH}"
setenv LD_LIBRARY_PATH   "${REST_PATH}/lib:${LD_LIBRARY_PATH}"
if ( $?LIBRARY_PATH == 0 ) setenv LIBRARY_PATH ''
setenv LIBRARY_PATH "${REST_PATH}/lib:${LIBRARY_PATH}"

echo "REST @PROJECT_VERSION@ loaded from ${REST_PATH}"
