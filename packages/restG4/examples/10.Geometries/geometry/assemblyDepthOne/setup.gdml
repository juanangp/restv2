<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- ##VERSION REST Example 10.Geometries Version 1.0## -->

<!DOCTYPE gdml [
        <!ENTITY geometry SYSTEM "geometry.gdml">
        ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

    <!-- All values should be in mm -->

    <define>
        <constant name="world_size" value="20000"/>


        <constant name="detectorSizeDiameter" value="100"/>
        <constant name="detectorSizeZ" value="50"/>

        <constant name="layer1Thickness" value="20"/>
        <constant name="layer2Thickness" value="100"/>
        <constant name="layer3Thickness" value="100"/>

        <constant name="2PI" value="6.283185307179586"/>
    </define>


    &geometry;


    <setup name="Default" version="1.0">
        <world ref="World"/>
    </setup>

</gdml>
