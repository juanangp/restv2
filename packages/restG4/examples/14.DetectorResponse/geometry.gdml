<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- ##VERSION REST Example 14.DetectorResponse Version 1.1## -->

<!DOCTYPE gdml [
        <!-- Parameter of DetectorResponse.yaml: the gas, a material of materials.xml
             (% written &#37; in an entity; restG4 option set: gas=XenonNeon2.3%Isobutane1.5bar) -->
        <!ENTITY gas "Xenon30&#37;Neon1.5bar">
        <!ENTITY geometry SYSTEM "geometry.gdml">
		<!ENTITY materials SYSTEM "https://github.com/rest-for-physics-toolkit/rest-common-materials/releases/download/v1.0/materials.xml">
        ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

    <define>
		<!-- All lenghts should be in mm -->
        <constant name="world_size" value="20000"/>

		<!-- Parameters of DetectorResponse.yaml: drift length and detector size (mm) -->
		<constant name="drift" value="30"/>
		<constant name="detectorSize" value="60"/>
    </define>

    &materials;

	<solids>
		<box name="WorldSolid" x="world_size" y="world_size" z="world_size" lunit="mm"/>
		<box name="targetSolid" startphi="0" deltaphi="360" x="detectorSize" y="detectorSize" z="drift" lunit="mm"/>
	</solids>

	<structure>

	<volume name="targetVolume">
		<materialref ref="&gas;"/>
		<solidref ref="targetSolid"/>
	</volume>

	<volume name="World">
		<materialref ref="Vacuum"/>
		<solidref ref="WorldSolid"/>

		<physvol name="target">
			<volumeref ref="targetVolume"/>
			<position name="targetPos" unit="mm" x="0" y="0" z="0"/>
		</physvol>
	</volume>

	</structure>

    <setup name="Default" version="1.0">
        <world ref="World"/>
    </setup>

</gdml>
